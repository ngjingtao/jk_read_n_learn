# Keep the build context small and, more importantly, keep stale build output
# out of the image. A copied-in `build/` directory would shadow the freshly
# compiled one and silently deploy old code.

.git
.github
.gitignore
.gitattributes

# Build output and caches — the whole point of building inside the image.
build
.dart_tool
.flutter-plugins
.flutter-plugins-dependencies

# Local run artefacts.
*.log
run.log
run.err.log

# Not needed to compile the web app.
test
docs
android
ios
linux
macos
windows

# Editor and OS noise.
.idea
.vscode
*.iml
.DS_Store
